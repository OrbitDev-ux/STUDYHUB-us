# ==================================
# Supabase
# ==================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# service_role 키는 절대 클라이언트에 노출되지 않습니다 (Server Action/Route Handler 전용)

# ==================================
# 인증
# ==================================
# 임시로 이메일 인증 메일 발송/확인 과정을 건너뛰고 가입 즉시 자동 확인/로그인하려면 true.
# (Supabase 무료 프로젝트의 내장 메일 발송 rate limit을 개발 중에 피하기 위한 옵션.
#  운영에서는 false로 두거나 값 자체를 지워서 정상 이메일 인증 플로우를 쓰세요.)
AUTH_EMAIL_CONFIRMATION_DISABLED=false

# ==================================
# AI
# AI_PROVIDER: "anthropic"(기본값) 또는 "glm". 미설정 시 anthropic 사용.
# ==================================
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# AI_PROVIDER=glm 일 때만 필요 (Z.ai 발급 키)
GLM_API_KEY=your-glm-api-key

# ==================================
# Discord OAuth (계정 연동 / 봇 동기화)
# ==================================
DISCORD_CLIENT_ID=your-discord-app-client-id
DISCORD_CLIENT_SECRET=your-discord-app-client-secret
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_GUILD_ID=your-discord-server-id
DISCORD_PREMIUM_ROLE_ID=your-premium-role-id
# (선택) 점검 모드 on/off를 알려줄 Discord 채널 웹훅. Discord 채널 설정 > 연동 > 웹훅에서 발급.
# 미설정 시 점검 모드는 정상 동작하되 알림만 안 보냅니다.
DISCORD_MAINTENANCE_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxx/xxxxx

# ==================================
# Google OAuth
# (Supabase Dashboard > Authentication > Providers 에서도 별도 설정 필요)
# ==================================
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# ==================================
# 앱 설정
# ==================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ==================================
# 크론 작업 인증 (Vercel Cron -> Route Handler)
# ==================================
CRON_SECRET=generate-a-random-secret-string
